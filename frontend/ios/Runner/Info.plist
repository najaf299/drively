	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.235533661523-bl0bs1osbrjef6ljb76hjvn7ckjdfdar</string>
			</array>
		</dict>
	</array>
